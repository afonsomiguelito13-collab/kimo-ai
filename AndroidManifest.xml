<!-- AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Apenas a permissão de Internet é necessária -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 
      NOTA PARA O ANDROID 13+ (API 33+):
      Ficheiros .gguf são classificados como documentos/ficheiros gerais e NÃO como media pura 
      (como imagens READ_MEDIA_IMAGES ou áudio READ_MEDIA_AUDIO). 
      Por isso, as permissões granulares de media do Android 13 não funcionam para ficheiros .gguf.
      
      A abordagem moderna recomendada pela Google é utilizar o Storage Access Framework (SAF) 
      através do seletor nativo de ficheiros do sistema. Isto significa que NÃO precisas de declarar 
      nenhuma permissão perigosa de armazenamento no Manifesto para conseguir carregar o teu .gguf.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Kimo AI"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
